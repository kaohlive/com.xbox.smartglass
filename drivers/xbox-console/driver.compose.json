{
  "name": {
    "en": "Xbox console"
  },
  "class": "gameconsole",
  "capabilities": [
    "onoff"
  ],
  "pair": [
    {
      "id": "additional_ip"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "large": "/drivers/xbox-console/assets/images/large.png",
    "small": "/drivers/xbox-console/assets/images/small.png"
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Console settings",
        "nl": "Console instellingen"
      },
      "children": [
        {
          "id": "liveid",
          "type": "text",
          "label": {
            "en": "Live ID",
            "nl": "Live ID"
          },
          "value": ""
        },
        {
          "id": "console_address",
          "type": "text",
          "label": {
            "en": "IP4 address",
            "nl": "IP4 addres"
          },
          "value": ""
        },
        {
          "id": "track_active_app",
          "type": "checkbox",
          "label": {
            "en": "Track active app",
            "nl": "Volg actieve app"
          },
          "hint": {
            "en": "Enables the 'app playing changed' and 'started gaming' flow triggers and the currently-playing album art. Keeps a SmartGlass session (without input control) open in the background. Disable only if you observe the console waking from silent install mode.",
            "nl": "Activeert de flow triggers 'actieve app veranderd' en 'begonnen met spelen' en de album art van de spelende app. Houdt een SmartGlass-sessie (zonder input-control) open op de achtergrond. Schakel alleen uit als je merkt dat de console wakker wordt uit silent install."
          },
          "value": true
        }
      ]
    }
  ]
}