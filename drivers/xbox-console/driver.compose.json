{
  "name": {
    "en": "Xbox console"
  },
  "class": "gameconsole",
  "capabilities": [
    "onoff"
  ],
  "pair": [
    {
      "id": "additional_ip"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "large": "/drivers/xbox-console/assets/images/large.png",
    "small": "/drivers/xbox-console/assets/images/small.png"
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Console settings",
        "nl": "Console instellingen"
      },
      "children": [
        {
          "id": "liveid",
          "type": "text",
          "label": {
            "en": "Live ID",
            "nl": "Live ID"
          },
          "value": ""
        },
        {
          "id": "console_address",
          "type": "text",
          "label": {
            "en": "IP4 address",
            "nl": "IP4 addres"
          },
          "value": ""
        },
        {
          "id": "track_active_app",
          "type": "checkbox",
          "label": {
            "en": "Track active app (keeps Xbox awake)",
            "nl": "Volg actieve app (houdt Xbox wakker)"
          },
          "hint": {
            "en": "Required for the 'app playing changed' and 'started gaming' flow triggers. When enabled, a SmartGlass session is kept open which can prevent the console from entering low-power / silent install mode.",
            "nl": "Nodig voor de flow triggers 'actieve app veranderd' en 'begonnen met spelen'. Wanneer ingeschakeld blijft een SmartGlass-sessie open, wat kan voorkomen dat de console in standby of stille installatiemodus gaat."
          },
          "value": false
        }
      ]
    }
  ]
}