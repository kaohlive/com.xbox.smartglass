{
  "id": "com.xbox.smartglass",
  "version": "1.3.4",
  "compatibility": ">=12.0.0",
  "brandColor": "#107c10",
  "sdk": 3,
  "name": {
    "en": "Xbox console companion"
  },
  "description": {
    "en": "Interact with your Xbox using the smartglass features"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.jpg",
    "small": "/assets/images/small.jpg"
  },
  "author": {
    "name": "Kaoh",
    "email": "kaoh@kaoh.nl"
  },
  "contributors": {
    "developers": [
      {
        "name": "Arie J. Godschalk",
        "email": "arie@qluster-it.nl"
      }
    ]
  },
  "homeyCommunityTopicId": 26223,
  "source": "https://github.com/kaohlive/com.xbox.smartglass",
  "api": {
    "getAuthStatus": {
      "method": "GET",
      "path": "/auth/status",
      "public": false
    },
    "startAuth": {
      "method": "POST",
      "path": "/auth/start",
      "public": false
    },
    "signOut": {
      "method": "POST",
      "path": "/auth/signout",
      "public": false
    },
    "getDiagnosticsEvents": {
      "method": "GET",
      "path": "/diagnostics/events",
      "public": false
    },
    "clearDiagnosticsEvents": {
      "method": "POST",
      "path": "/diagnostics/clear",
      "public": false
    }
  }
}